{
  "NODE_ENV": {
    "type": "enum",
    "values": [
      "development",
      "test",
      "production"
    ],
    "required": true,
    "default": "development",
    "description": "Runtime mode. Affects logging and error detail."
  },
  "SERVICE_NAME": {
    "type": "string",
    "required": true,
    "minLength": 2,
    "description": "Used in logs, metrics and the health endpoint."
  },
  "PORT": {
    "type": "port",
    "required": true,
    "default": 3000,
    "description": "Port the HTTP server binds to."
  },
  "DATABASE_URL": {
    "type": "url",
    "required": true,
    "protocols": [
      "postgres:",
      "postgresql:"
    ],
    "description": "PostgreSQL connection string."
  },
  "API_KEY": {
    "type": "string",
    "required": true,
    "secret": true,
    "minLength": 12,
    "hint": "generate one with: openssl rand -hex 24",
    "description": "Key used to sign outbound API requests."
  },
  "DEBUG": {
    "type": "boolean",
    "required": false,
    "default": false,
    "description": "Verbose request logging."
  },
  "REQUEST_TIMEOUT": {
    "type": "duration",
    "required": false,
    "default": "30s",
    "description": "Upstream timeout, converted to milliseconds."
  },
  "LOG_LEVEL": {
    "type": "enum",
    "values": [
      "debug",
      "info",
      "warn",
      "error"
    ],
    "required": false,
    "default": "info",
    "description": "Minimum level written to stdout."
  },
  "FEATURE_FLAGS": {
    "type": "json",
    "required": false,
    "default": "{}",
    "description": "Inline feature-flag overrides."
  },
  "SENTRY_DSN": {
    "type": "url",
    "required": false,
    "protocols": [
      "https:"
    ],
    "secret": true,
    "description": "Optional error-reporting endpoint."
  }
}
