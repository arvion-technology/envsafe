# Generated by EnvSafe. Copy to .env and fill in the values.

# Runtime mode. Affects logging and error detail.
# enum, required
# allowed: development, test, production
NODE_ENV=development

# Used in logs, metrics and the health endpoint.
# string, required
SERVICE_NAME=

# Port the HTTP server binds to.
# port, required
PORT=3000

# PostgreSQL connection string.
# url, required
DATABASE_URL=

# Key used to sign outbound API requests.
# string, required, secret
API_KEY=

# Verbose request logging.
# boolean
DEBUG=false

# Upstream timeout, converted to milliseconds.
# duration
REQUEST_TIMEOUT=30s

# Minimum level written to stdout.
# enum
# allowed: debug, info, warn, error
LOG_LEVEL=info

# Inline feature-flag overrides.
# json
FEATURE_FLAGS={}

# Optional error-reporting endpoint.
# url, secret
SENTRY_DSN=
